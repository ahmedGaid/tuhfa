{
  "name": "tuhfa",
  "private": true,
  "version": "0.1.0",
  "description": "تحفة — تعلّم أحكام التجويد بأسلوب Duolingo",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . && node scripts/check-feedback-colours.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "validate": "node scripts/validate.ts",
    "content:extract": "node scripts/extract-prototype.ts",
    "content:locate": "node scripts/locate-ayah.ts madd && node scripts/content-notes.ts madd",
    "content:apply": "node scripts/locate-ayah.ts madd --apply && node scripts/content-notes.ts madd"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/scheherazade-new": "^5.3.0",
    "@preact/signals": "^2.11.4",
    "preact": "^11.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
